# Copy to server/.env and adjust. No real secrets belong in this file.

# PostgreSQL connection string (matches docker-compose.yml / `npm run db:embedded`)
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety

# API
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the web app, used for links inside emails (defaults to the first CLIENT_ORIGIN)
# APP_URL=http://localhost:5173
NODE_ENV=development

# Secret used to sign login tokens. REQUIRED in production - use a long random string.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email via the Mailgun HTTP API. FROM_EMAIL's domain must be an active sending domain on the
# Mailgun account. Leave MAILGUN_API_KEY empty to print emails to the server console instead
# (handy for local development: verification and reset links show up there).
MAILGUN_API_KEY=
MAILGUN_BASE_URL=https://api.mailgun.net
FROM_EMAIL=sweety@mx.adarsh.run
MAILGUN_SENDER_NAME=Sweety

# Web push for reminders. Generate a pair with: npm --prefix server run vapid
# Leave empty to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Security (all optional)
# The session cookie is always httpOnly + SameSite=Lax; "Secure" (HTTPS only) is on by default in production.
# COOKIE_SECURE=true
# Lock an account after this many wrong passwords, for this many minutes
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Max requests per 15 minutes per IP on /api/auth
AUTH_RATE_LIMIT=100

# Logging: trace | debug | info | warn | error | silent (JSON lines in production, readable output in dev)
LOG_LEVEL=info

# Development / end-to-end tests only: write each email as a JSON line into this folder instead of
# sending or printing it. Ignored when NODE_ENV=production.
# MAIL_OUTBOX_DIR=./.outbox

# Optional: Redis enables report caching and runs the reminder job on BullMQ (otherwise it runs
# in-process on a timer). Leave empty to run without Redis.
REDIS_URL=
REPORT_CACHE_TTL=300
# How often to look for users whose reminder time has arrived
REMINDER_CRON=*/10 * * * *
REMINDER_INTERVAL_MS=600000

# Optional, tests only: run integration tests against this DB instead of a throwaway embedded Postgres
# TEST_DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety_test
